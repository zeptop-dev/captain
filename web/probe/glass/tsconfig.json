{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/glass.tsbuildinfo",
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "../glass-shared/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../glass-shared/**/*.ts",
    "../src/lib/**/*.ts",
    "../src/appearance.ts",
    "../../shared/branding.ts"
  ]
}
