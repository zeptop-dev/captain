[Unit]
Description=Captain panel
After=network-online.target
Wants=network-online.target

[Service]
User=captain
Group=captain
ExecStart=/usr/local/bin/captain serve -c /etc/captain/config.yaml
Restart=always
RestartSec=3
StateDirectory=captain
WorkingDirectory=/var/lib/captain
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/captain

[Install]
WantedBy=multi-user.target
